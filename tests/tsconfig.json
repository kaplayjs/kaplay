// Used just for Type Check of tests... Not used for generate anything

{
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitThis": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    // Always use import type for type only imports
    "verbatimModuleSyntax": true,
    "strict": true,
    "types": [
      "./.env.d.ts"
    ]
  },
  "include": [
    "./**/*"
  ]
}
