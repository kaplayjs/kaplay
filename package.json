{
  "name": "kaplay",
  "description": "KAPLAY is a JavaScript & TypeScript game library that helps you make games fast and fun!",
  "version": "4000.0.0-alpha.27.1",
  "license": "MIT",
  "homepage": "https://v4000.kaplayjs.com/",
  "bugs": {
    "url": "https://github.com/kaplayjs/kaplay/issues"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/kaplay"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaplayjs/kaplay.git"
  },
  "type": "module",
  "main": "./dist/kaplay.cjs",
  "module": "./dist/kaplay.mjs",
  "types": "./dist/doc.d.ts",
  "readme": "./README.md",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/doc.d.ts",
        "default": "./dist/kaplay.mjs"
      },
      "require": {
        "types": "./dist/doc.d.ts",
        "default": "./dist/kaplay.cjs"
      }
    },
    "./global": "./dist/declaration/global.js"
  },
  "typesVersions": {
    "*": {
      "global": [
        "./dist/declaration/global.d.ts"
      ]
    }
  },
  "keywords": [
    "game development",
    "javascript",
    "typescript",
    "game engine",
    "2d games",
    "physics engine",
    "webgl",
    "canvas",
    "game library",
    "kaplay",
    "kaboom",
    "kaboomjs"
  ],
  "files": [
    "dist/",
    "kaplay.webp",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node scripts/start.ts",
    "dev": "node scripts/start.ts",
    "build": "npm run generate:index && npm run generate:dts && node scripts/build.ts",
    "check": "tsc",
    "lint": "eslint .",
    "fmt": "dprint fmt",
    "fmt:commit": "dprint fmt && git diff --quiet --cached && echo \"No changes\" || (git add . && git commit -m \"style: fmt\")",
    "generate:index": "node scripts/generateIndex.js",
    "generate:dts": "dts-bundle-generator -o dist/doc.d.ts src/index.ts",
    "test": "npm exec playwright test",
    "test:setup": "npm exec playwright install",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@kaplayjs/crew": "2.0.0-beta.6",
    "@kaplayjs/dprint-config": "^1.2.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "cross-env": "^10.1.0",
    "dprint": "^0.55.2",
    "dts-bundle-generator": "^9.5.1",
    "ejs": "^3.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^50.8.0",
    "express": "^5.2.1",
    "tar-fs": "^3.1.2",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "dprint@0.55.2": true,
    "dprint@0.49.1": true,
    "esbuild@0.28.2": true,
    "puppeteer@25.7.0": true
  },
  "overrides": {
    "axios@>=1.0.0 <1.15.0": ">=1.15.0",
    "basic-ftp@<=5.2.1": ">=5.2.2",
    "basic-ftp@<=5.2.2": ">=5.3.0",
    "basic-ftp@=5.2.0": ">=5.2.1",
    "follow-redirects@<=1.15.11": ">=1.16.0"
  }
}
