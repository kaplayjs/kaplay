# prize model
mtllib meshes/prize.mtl
o prize
v 0 0 32
v 64 0 32
v 64 64 32
v 0 64 32
v 0 0 -32
v 64 0 -32
v 64 64 -32
v 0 64 -32
vt 0 0
vt 1 0
vt 1 1
vt 0 1

usemtl prize_mtl
s off
# front
f 1/1/ 2/2/ 4/4/
f 2/2/ 3/3/ 4/4/
# left
f 5/1/ 1/2/ 8/4/
f 1/2/ 4/3/ 8/4/
# right
f 2/1/ 6/2/ 3/4/
f 6/2/ 7/3/ 3/4/
# back
f 6/1/ 5/2/ 7/4/
f 5/2/ 8/3/ 7/4/
usemtl prize_top_mtl
# top
f 5/1/ 6/2/ 1/4/
f 6/2/ 2/3/ 1/4/
# bottom
f 4/1/ 3/2/ 8/4/
f 3/2/ 7/3/ 8/4/