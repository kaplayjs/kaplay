Set Height 900
Set Theme { "name": "Kaplay", "black": "#20252e", "red": "#e25a61", "green": "#5ba675", "yellow": "#fcef8d", "blue": "#7b5480", "purple": "#ee8fcb", "cyan": "#6bc96c", "white": "#ffffff", "brightBlack": "#4a3052", "brightRed": "#cc425e", "brightGreen": "#abdd64", "brightYellow": "#fcef8d", "brightBlue": "#7b5480", "brightPurple": "#f2ae99", "brightCyan": "#6bc96c", "brightWhite": "#ffffff", "background": "#20252e", "foreground": "#5ba675", "selection": "#4a3052", "cursor": "#5ba675" }

Type "npx create-kaplay my-game"
